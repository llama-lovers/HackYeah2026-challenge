{
  "manifest_version": 3,
  "name": "Głosowy agent",
  "version": "0.2.1",
  "description": "Głosowy asystent dla osób niewidomych na polskich stronach.",
  "key": "",
  "minimum_chrome_version": "116",
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tts"
  ],
  "host_permissions": [
    "__PROXY_ORIGIN__/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://inpost.pl/*",
        "https://www.inpost.pl/*",
        "https://google.com/*",
        "https://www.google.com/*",
        "https://google.pl/*",
        "https://www.google.pl/*",
        "__PROXY_ORIGIN__/fixtures/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Rozpocznij lub zakończ nagrywanie polecenia głosowego"
    }
  }
}
