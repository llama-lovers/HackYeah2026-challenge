# GŁÓWNY PRZEŁĄCZNIK: openrouter albo local
ASR_BACKEND=openrouter

# Używane wyłącznie dla ASR_BACKEND=openrouter:
OPENROUTER_API_KEY=XD
OPENROUTER_MODEL=nvidia/parakeet-tdt-0.6b-v3
REQUEST_TIMEOUT_SECONDS=90

# Używane wyłącznie dla ASR_BACKEND=local:
MODEL_NAME=nvidia/parakeet-tdt-0.6b-v3
DEVICE=cuda

# Wyniki częściowe i poprawianie tekstu — dla OBU backendów.
# OpenRouter: kolejne partial to osobne płatne żądania dla rosnącego audio.
ENABLE_PARTIALS=true

# Wspólny podział audio przez VAD, parametry w milisekundach.
END_SILENCE_MS=600
MAX_SEGMENT_MS=5000
PRE_ROLL_MS=300
SPEECH_START_MS=60
VAD_MODE=2
PARTIAL_INTERVAL_MS=800
MIN_PARTIAL_MS=1000
MAX_CONNECTIONS=4
MAX_PENDING_SEGMENTS=4
MAX_MESSAGE_BYTES=64000
IDLE_TIMEOUT_S=60
SEND_TIMEOUT_S=15
WORD_TIMESTAMPS=false