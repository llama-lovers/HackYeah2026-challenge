# Copy to config.env. Environment variables override this file.
TTS_BACKEND=local
TTS_LOCAL_VOICE=pl_PL-mc_speech-medium
TTS_MODEL_DIR=models
# high_variation, selected in the Piper benchmark
TTS_LENGTH_SCALE=1.0
TTS_NOISE_SCALE=0.85
TTS_NOISE_W_SCALE=1.0
TTS_VOLUME=1.0
TTS_NORMALIZE_TEXT=false
TTS_HOST=0.0.0.0
TTS_PORT=7001
TTS_MAX_TEXT_CHARS=4000
TTS_REQUEST_TIMEOUT_SECONDS=60
# Optional OpenRouter TTS; select a speech model and its supported voice.
TTS_OPENROUTER_API_KEY=
TTS_OPENROUTER_MODEL=
TTS_OPENROUTER_VOICE=
