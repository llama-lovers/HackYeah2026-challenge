# OpenRouter API key, no default; keep the real value in untracked server/.env
OPENROUTER_API_KEY=
# Pinned chat model, default anthropic/claude-sonnet-5.5
CHAT_MODEL=
# OpenRouter base URL, default https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Chat request timeout in seconds, default 15
OPENROUTER_TIMEOUT_S=
# Transcription mode stub or whisper, default stub
STT_MODE=
# Stub transcript, default kliknij Znajdź
STT_STUB_TEXT=
# Upload size cap in bytes, default 2097152
MAX_BODY_BYTES=
# Fixed extension ID, derived from extension/static/manifest.json by default
EXTENSION_ID=
# Additional hosts; add a LAN IP and --host 0.0.0.0 only for the NVDA test machine
ALLOWED_HOSTS=
# Warm both schemas at startup, default false; 1 or true enables it
WARMUP_ON_START=
